# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and aqcuire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://dashboard.example.com

# Environment: local, staging, production
ENVIRONMENT=local

# Dev host ports. Defaults match the template; change these (or set a Copier
# dev_port_offset) so several stacks generated from this template can run at the
# same time without collisions. Containers keep their internal ports; only the
# host-side mapping changes. (POSTGRES_PORT lives in the Postgres section below.)
FRONTEND_PORT=5173
BACKEND_PORT=8000
ADMINER_PORT=8080
TRAEFIK_UI_PORT=8090
PROXY_HTTP_PORT=80
MAILCATCHER_UI_PORT=1080
MAILCATCHER_SMTP_PORT=1025
PLAYWRIGHT_PORT=9323

PROJECT_NAME="Full Stack FastAPI Project"
STACK_NAME=full-stack-fastapi-project

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# OIDC / SSO (optional). Set ISSUER + CLIENT_ID + CLIENT_SECRET (all three) to
# enable "Log in with SSO"; leave empty to keep password login only.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Only needed behind a proxy that can't derive the public callback URL:
OIDC_REDIRECT_URI=
# Provider group whose members become superusers:
OIDC_ADMIN_GROUP=admins
# Set to False to make SSO the only login method:
PASSWORD_LOGIN_ENABLED=True
# Set to True to allow open self-service signup:
USERS_OPEN_REGISTRATION=False

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

SENTRY_DSN=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
